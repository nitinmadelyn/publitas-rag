{
  "name": "publitas-rag",
  "version": "0.1.0",
  "description": "RAG chat system over Publitas digital catalogs",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:migrations",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres && docker compose exec postgres sh -c 'until pg_isready -U publitas -d publitas_rag; do sleep 1; done'",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "embed": "tsx src/scripts/embed.ts",
    "search": "tsx src/scripts/search.ts",
    "chat": "tsx src/scripts/chat.ts",
    "widget:build": "node web/widget/build.mjs --prod",
    "widget:dev": "node web/widget/build.mjs --watch",
    "widget:typecheck": "tsc --noEmit -p web/widget/tsconfig.json",
    "loadtest:server": "tsx src/scripts/load-test-server.ts",
    "loadtest": "tsx src/scripts/load-test.ts",
    "copy:migrations": "mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "autocannon": "^8.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
