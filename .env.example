# Copy this file to .env and fill in real values. Never commit .env.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# --- Database ---
# Local dev default matches docker-compose.yml. Use a real connection string in staging/prod.
DATABASE_URL=postgresql://publitas:publitas_dev_password@localhost:5433/publitas_rag
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# --- Publitas API ---
PUBLITAS_API_BASE_URL=https://api.publitas.com/v1
PUBLITAS_API_TIMEOUT_MS=10000
PUBLITAS_API_MAX_RETRIES=3
PUBLITAS_PRODUCT_FETCH_CONCURRENCY=5

# --- Embeddings / LLM ---
OPENAI_API_KEY=sk-replace-me
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=claude-sonnet-5

# --- Embedding pipeline ---
EMBEDDING_BATCH_SIZE=96
EMBEDDING_MAX_CHARS_PER_BATCH=100000
EMBEDDING_MAX_CHARS_PER_CHUNK=32000
EMBEDDING_FETCH_PAGE_SIZE=500
EMBEDDING_REQUEST_CONCURRENCY=3
EMBEDDING_MAX_ATTEMPTS=5
EMBEDDING_API_TIMEOUT_MS=20000
EMBEDDING_API_MAX_RETRIES=4

# --- Generation ---
CLAUDE_API_KEY=sk-ant-replace-me
CLAUDE_MAX_TOKENS=1024
CLAUDE_API_TIMEOUT_MS=30000
CLAUDE_API_MAX_RETRIES=3

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_RELEVANCE_THRESHOLD=0.75
RETRIEVAL_LEXICAL_LIMIT=10
RETRIEVAL_LEXICAL_MIN_SIMILARITY=0.3

# --- API layer (Phase 7) ---
API_KEYS=dev-local-key-change-me
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
CORS_ALLOWED_ORIGINS=*
